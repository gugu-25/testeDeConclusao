        <servlet-name>GerenciarDiaria_quarto_servico</servlet-name>
        <servlet-class>controller.GerenciarDiaria_quarto_servico</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GerenciarQuarto</servlet-name>
        <servlet-class>controller.GerenciarQuarto</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GerenciarServico</servlet-name>
        <servlet-class>controller.GerenciarServico</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GerenciarPendencias</servlet-name>
        <servlet-class>controller.GerenciarPendencias</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GerenciarDiaria</servlet-name>
        <url-pattern>/gerenciar_diaria.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GerenciarCliente</servlet-name>
        <url-pattern>/gerenciar_cliente.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GerenciarLogin</servlet-name>
        <url-pattern>/gerenciar_login.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GerenciarUsuario</servlet-name>
        <url-pattern>/gerenciar_usuario.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GerenciarPerfil</servlet-name>
        <url-pattern>/gerenciar_perfil.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GerenciarMenu</servlet-name>
        <url-pattern>/gerenciar_menu.do</url-pattern>
