    <servlet-mapping>
        <servlet-name>GerenciarPendencias</servlet-name>
        <url-pattern>/gerenciar_pendencias.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <error-page>
        <error-code>403</error-code>
        <location>/acesso_negado.jsp</location>
    </error-page>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
